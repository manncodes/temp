{
  "mcpServers": {
    "arxiv": {
      "command": "arxiv-mcp-server",
      "args": ["--storage-path", "/home/user/temp/.arxiv-papers"],
      "env": {}
    },
    "fetch": {
      "command": "python3",
      "args": ["-m", "mcp_server_fetch"],
      "env": {}
    },
    "huggingface": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://huggingface.co/mcp"],
      "env": {}
    }
  }
}
